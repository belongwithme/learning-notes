{
  "name": "learning-notes",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build --force",
    "check": "npm run check:headings && astro check",
    "check:headings": "node scripts/normalize-markdown-headings.mjs --check",
    "preview": "astro preview",
    "astro": "astro",
    "db:english": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/english-db.mjs",
    "test:english": "node --env-file=.env.local scripts/test-english.mjs",
    "test:good-pairs": "node --experimental-strip-types scripts/test-good-pairs.mjs",
    "test:prefix-sum": "node --experimental-strip-types scripts/test-prefix-sum.mjs",
    "test:difference": "node --experimental-strip-types scripts/test-difference.mjs",
    "english:context": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/english-context.mjs",
    "english:save": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/english-save.mjs",
    "english:context:production": "env -u DATABASE_URL node --env-file=.local/english-production.env --experimental-strip-types scripts/english-context.mjs",
    "english:save:production": "env -u DATABASE_URL node --env-file=.local/english-production.env --experimental-strip-types scripts/english-save.mjs",
    "test:english-analysis": "node --experimental-strip-types --test scripts/test-english-analysis.mjs",
    "test:english-practice": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/test-english-practice.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@astrojs/vercel": "^11.0.13",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/noto-serif-sc": "^5.2.10",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.0.2",
    "mermaid": "^11.17.2",
    "pg": "^8.23.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
