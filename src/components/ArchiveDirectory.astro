---
import { getCollection } from 'astro:content';
import { KnowledgeCategories } from '../config/site-routing';

// Overview pages (`index`) are not counted as notes.
const notes = await getCollection('docs', doc => doc.id.startsWith('knowledge/') && !doc.id.endsWith('/index'));
const countFor = (id: string) => notes.filter(doc => doc.id.startsWith(`knowledge/${id}/`)).length;
---

<div class="archive-directory not-content">
	<div class="archive-directory-head" aria-hidden="true">
		<span>编号</span>
		<span>知识领域</span>
		<span>文章数</span>
	</div>

	<ol>
		{KnowledgeCategories.map((category, index) => (
			<li>
				<a class="archive-directory-row" href={`/knowledge/${category.id}/`}>
					<span class="archive-directory-number">{String(index + 1).padStart(2, '0')}</span>
					<span class="archive-directory-main">
						<strong>{category.label}</strong>
						<small>{category.desc}</small>
					</span>
					<span class="archive-directory-status">{countFor(category.id)} 篇</span>
				</a>
			</li>
		))}
	</ol>
</div>
