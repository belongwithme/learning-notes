---
import { noteLocation, readingMinutes } from '../lib/notes';

const entry = Astro.locals.starlightRoute.entry;
const data = entry.data;
const location = noteLocation(entry.id);

// 页面标题是文章的唯一主视觉层，状态元信息保持安静。
const statusMap: Record<string, { label: string, class: string }> = {
  draft: { label: '原样导入', class: 'status-draft' },
  curated: { label: '已整理', class: 'status-curated' },
  evergreen: { label: '常青', class: 'status-evergreen' },
  outdated: { label: '已过期', class: 'status-outdated' },
};

const currentStatus = location ? statusMap[data.status ?? 'draft'] : data.status && statusMap[data.status];
// 专题概览页带 hero，不计入首页的"继续阅读"。
const recordVisit = Boolean(location) && !data.hero;
---

{location && (
  <nav class="note-breadcrumb" aria-label="面包屑">
    <a href={location.area.href} data-pagefind-filter="专题">{location.area.label}</a>
    <span aria-hidden="true">/</span>
    <a href={location.sub.href}>{location.sub.label}</a>
  </nav>
)}

<h1 id="_top">{data.sidebar.label ?? data.title}</h1>

{(location || currentStatus) && (
  <p class="page-meta">
    {location && <span>约 {readingMinutes(entry.body)} 分钟</span>}
    {currentStatus && (
      <a class={`page-status ${currentStatus.class}`} href="/about/#内容状态">
        <span class="status-dot" aria-hidden="true"></span>{currentStatus.label}
      </a>
    )}
  </p>
)}

{recordVisit && (
  <script is:inline define:vars={{ title: data.sidebar.label ?? data.title }}>
    try {
      const notes = JSON.parse(localStorage.getItem('recent-notes') || '[]')
        .filter(note => note.href !== location.pathname);
      notes.unshift({ href: location.pathname, title });
      localStorage.setItem('recent-notes', JSON.stringify(notes.slice(0, 4)));
    } catch {}
  </script>
)}

<style>
  h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .note-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    font-size: 0.82rem;
    color: var(--archive-muted, var(--sl-color-gray-3));
  }
  .note-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }
  .note-breadcrumb a:hover {
    color: var(--sl-color-text-accent);
  }
  .page-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin: 1rem 0 0.25rem;
    color: var(--archive-muted, var(--sl-color-gray-3));
    font-size: 0.8rem;
    line-height: 1.4;
  }
  .page-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }
  .page-status:hover {
    color: var(--sl-color-text-accent);
  }
  .status-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--archive-accent, var(--sl-color-text-accent));
  }
  .status-draft .status-dot {
    background: transparent;
    box-shadow: inset 0 0 0 1px currentColor;
  }
  .status-outdated .status-dot {
    background: #b45309;
  }
</style>
