---
import Default from '@astrojs/starlight/components/Pagination.astro';

// Keep "previous / next" inside the current section, so a note never leads to another area.
const { entry, pagination } = Astro.locals.starlightRoute;
const segments = entry.id.split('/');
const scope = segments.length >= 3 ? segments.slice(0, -1).join('/') : entry.id;
const inScope = (link?: { href: string }) => link && decodeURI(link.href).startsWith(`/${scope}/`) ? link : undefined;

pagination.prev = inScope(pagination.prev);
pagination.next = inScope(pagination.next);
---

<Default />
