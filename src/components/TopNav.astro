---
// Rendered in Starlight's SocialIcons slot: the header on wide screens and the mobile menu footer.
const links = [
	{ label: '专题', href: '/knowledge/' },
	{ label: '路线', href: '/learning-paths/' },
	{ label: '英语', href: '/english/' },
	{ label: '复盘', href: '/retrospectives/' },
];
const current = decodeURI(Astro.url.pathname);
---

<nav class="top-nav" aria-label="主要栏目">
	{links.map(link => (
		<a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
	))}
</nav>

<style>
	.top-nav {
		display: flex;
		gap: 1.25rem;
		font-size: 0.9rem;
		font-weight: 500;
	}
	.top-nav a {
		color: var(--archive-muted, var(--sl-color-gray-2));
		text-decoration: none;
		white-space: nowrap;
	}
	.top-nav a:hover,
	.top-nav a[aria-current='page'] {
		color: var(--archive-ink, var(--sl-color-white));
	}
</style>
